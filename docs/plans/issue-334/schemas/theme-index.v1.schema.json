{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bee-san/hachidori-theme-store/main/schema/index.schema.json",
  "title": "hachidori-theme-store catalogue (dist/index.json), schema 1",
  "description": "Generated by scripts/build-index.mjs from every themes/<slug>/theme.yaml; the only theme file Hachidori parses (JSON.parse, never YAML). Vendored as extension/vendor/themes/index.json and, after Refresh, stored as themes.catalogue. Runtime installs are colour data only (palette and variant entries carry their 18 palette values inline); renderer code is vendored with a release and never fetched. Paths are relative to https://raw.githubusercontent.com/<source.repository>/<source.commit>/. A consumer rejects the file if it exceeds 1 MiB or fails this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "themes"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "bee-san/hachidori-theme-store"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "palettes": {
      "$ref": "#/$defs/file",
      "description": "dist/palettes.css: every theme's palette block, the file Hachidori vendors as vendor/themes/palettes.css."
    },
    "themes": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/theme"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(dist|themes)/[a-z0-9][a-z0-9./-]{0,120}$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "version",
        "author",
        "description",
        "tags",
        "license",
        "minHachidoriVersion",
        "mode",
        "kind",
        "renderer",
        "installable",
        "palette"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "author": {
          "type": "string",
          "maxLength": 60
        },
        "link": {
          "type": "string",
          "pattern": "^https://"
        },
        "description": {
          "type": "string",
          "maxLength": 280
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z-]{2,20}$"
          }
        },
        "license": {
          "type": "string"
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "license"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "license": {
                "type": "string"
              }
            }
          }
        },
        "minHachidoriVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "mode": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "kind": {
          "enum": [
            "palette",
            "renderer",
            "variant"
          ]
        },
        "renderer": {
          "$ref": "#/$defs/slug",
          "description": "Renderer id to use: `default`, this theme's own slug (kind renderer) or the parent's slug (kind variant)."
        },
        "installable": {
          "enum": [
            "runtime",
            "release"
          ],
          "description": "runtime: colour data only (palette, or variant of a renderer the running release bundles) and may be used from a refreshed catalogue; release: contains renderer JavaScript that ships only inside a Hachidori release."
        },
        "palette": {
          "type": "object",
          "description": "The 18 theme.yaml palette values; Hachidori compiles them locally into the palette block, so no CSS is ever downloaded.",
          "minProperties": 18,
          "maxProperties": 18,
          "additionalProperties": {
            "type": "string",
            "maxLength": 80
          }
        },
        "js": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "css",
            "apiVersion",
            "glossary",
            "summary"
          ],
          "properties": {
            "file": {
              "$ref": "#/$defs/file",
              "description": "themes/<slug>/renderer.js at source.commit (vendored, never fetched by the extension)."
            },
            "css": {
              "$ref": "#/$defs/file"
            },
            "apiVersion": {
              "const": 1
            },
            "glossary": {
              "type": "array",
              "items": {
                "enum": [
                  "rich",
                  "text",
                  "none"
                ]
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "layout": {
              "type": "object",
              "properties": {
                "size": {
                  "enum": [
                    "fixed",
                    "content"
                  ]
                }
              },
              "additionalProperties": false
            },
            "ignores": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "needs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "summary": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "screenshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "width",
            "height"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "width": {
              "const": 1120
            },
            "height": {
              "const": 840
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "suggestedOptions": {
          "type": "object",
          "maxProperties": 14
        },
        "preview": {
          "type": "object",
          "properties": {
            "swatches": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "description": "Summary of benchmarks/<slug>.json (schema theme-benchmark.v1), written by CI on main for every theme, palettes included; absent until the first run.",
          "required": [
            "hachidoriCommit",
            "measuredAt",
            "verdict",
            "label",
            "hoverCompleteMedianMs",
            "nodes"
          ],
          "properties": {
            "hachidoriCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "measuredAt": {
              "type": "string",
              "format": "date"
            },
            "verdict": {
              "enum": [
                "pass"
              ]
            },
            "label": {
              "enum": [
                "lighter",
                "standard"
              ]
            },
            "hoverCompleteMedianMs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "default",
                "theme"
              ],
              "properties": {
                "default": {
                  "type": "number"
                },
                "theme": {
                  "type": "number"
                }
              }
            },
            "nodes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "default",
                "theme"
              ],
              "properties": {
                "default": {
                  "type": "integer"
                },
                "theme": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "renderer"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "js",
              "screenshot"
            ],
            "properties": {
              "js": true,
              "screenshot": true,
              "installable": {
                "const": "release"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "variant"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "screenshot"
            ],
            "properties": {
              "screenshot": true,
              "renderer": {
                "not": {
                  "const": "default"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "palette"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "renderer": {
                "const": "default"
              },
              "installable": {
                "const": "runtime"
              }
            }
          }
        }
      ]
    }
  }
}
