{
  "manifest_version": 3,
  "name": "ffproto",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "ffproto@test", "strict_min_version": "154.0" } },
  "background": { "scripts": ["bg.js"] },
  "permissions": ["storage"],
  "sandbox": { "pages": ["frame.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-eval'; child-src 'self'"
  },
  "web_accessible_resources": [{ "resources": ["war.css", "vendor/*", "war-classic.js", "war-module.js"], "matches": ["<all_urls>"] }]
}
