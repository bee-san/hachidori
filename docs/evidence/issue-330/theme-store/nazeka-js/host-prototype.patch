+    return {
+      update(css) {
+        if ((css ?? null) === current) return false;
+        shadowRoot.adoptedStyleSheets = shadowRoot.adoptedStyleSheets.filter(value => value !== sheet);
+        if (css) {
+          sheet ??= new CSSStyleSheet();
+          sheet.replaceSync(css);
+          const [reader, ...rest] = shadowRoot.adoptedStyleSheets;
+          shadowRoot.adoptedStyleSheets = reader ? [reader, sheet, ...rest] : [sheet, ...rest];
+        }
+        current = css ?? null;
+        return true;
+      },
+    };
