<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JL.Core.Tests</AssemblyName>
    <RootNamespace>HachidoriBenchmark</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <JLSource Condition="'$(JLSource)' == ''">$(HACHIDORI_BENCH_JL)</JLSource>
  </PropertyGroup>
  <Target Name="RequireJLSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(JLSource)' == ''" Text="Set JLSource or HACHIDORI_BENCH_JL to the pinned JL source checkout." />
    <Error Condition="!Exists('$(JLSource)/JL.Core/JL.Core.csproj')" Text="JL.Core.csproj was not found under $(JLSource)." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(JLSource)/JL.Core/JL.Core.csproj" />
    <Content Include="$(JLSource)/JL.Core/Resources/**/*">
      <Link>Resources/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
