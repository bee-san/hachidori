{
  "manifest_version": 3,
  "name": "Hachidori",
  "short_name": "Hachidori",
  "version": "0.1.0",
  "description": "Private Japanese hover lookups from your Yomitan dictionaries, entirely in Chrome.",
  "minimum_chrome_version": "118",
  "icons": {
    "16": "icons/hachidori-16.png",
    "32": "icons/hachidori-32.png",
    "48": "icons/hachidori-48.png",
    "128": "icons/hachidori-128.png"
  },
  "permissions": [
    "alarms",
    "downloads",
    "offscreen",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "js": [
        "reader-options.js",
        "dictionary-group-state.js",
        "lookup-stats-identity.js",
        "external-links.js",
        "audio-content.js",
        "anki-content.js",
        "render/glossary.js",
        "render/popup.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "render/reader.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
